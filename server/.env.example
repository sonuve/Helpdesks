# Template only — no real values. Copy to .env for local dev, or set these
# as service variables in Railway (or whatever platform) for a deployment.
# See CLAUDE.md for what each of these gates.

NODE_ENV="development"

# Local dev: docker/local Postgres. On Railway: reference the Postgres
# plugin's own variable, e.g. ${{Postgres.DATABASE_URL}}.
DATABASE_URL="postgresql://user@localhost:5433/helpdesk?schema=public"

# Generate a fresh value per environment — never reuse the same secret
# across dev/test/production. `openssl rand -base64 32` works.
BETTER_AUTH_SECRET=""
# The public URL this server is reachable at (e.g. your Railway domain in
# production, http://localhost:3001 in dev).
BETTER_AUTH_URL="http://localhost:3001"

# The public URL the client is served from. In the single-service Railway
# deployment (see Dockerfile) this is the SAME URL as BETTER_AUTH_URL,
# since the server serves the built client itself.
CLIENT_ORIGIN="http://localhost:5173"

# Comma-separated CIDR list of proxies allowed to set X-Forwarded-For (see
# CLAUDE.md's "Rate limiting"). Empty in dev (no proxy in front locally).
# Railway doesn't publish a fixed edge CIDR, but its proxy strips/
# overwrites any client-supplied X-Forwarded-For before forwarding — see
# the deployment writeup for the reasoning — so on Railway this is
# effectively "trust the one hop Railway itself adds":
#   TRUSTED_PROXY_CIDRS="0.0.0.0/0,::/0"
TRUSTED_PROXY_CIDRS=""

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""

# Shared secret for the email-ingestion webhook routes (POST /api/tickets'
# x-ingest-secret header, and POST /api/email/inbound/:secret).
EMAIL_INGEST_SECRET=""

# Google AI Studio free-tier key for the "Polish"/"Generate reply" buttons
# and the classify/auto-resolve background jobs. Leaving unset degrades
# those features (502 / logged-and-skipped) rather than breaking the app.
GOOGLE_GENERATIVE_AI_API_KEY=""

# SendGrid Mail Send API key + a verified sender identity, for actually
# sending reply emails. Leaving unset degrades reply-sending the same way.
# SENDGRID_API_KEY=""
# SENDGRID_FROM_EMAIL=""

# Sentry DSN for server-side error reporting. Leaving unset makes
# Sentry.init() a documented no-op.
SENTRY_DSN=""
