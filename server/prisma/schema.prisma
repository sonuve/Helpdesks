// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

model User {
  id              String        @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  role            Role          @default(AGENT)
  createdAt       DateTime
  updatedAt       DateTime
  deletedAt       DateTime?
  sessions        Session[]
  accounts        Account[]
  assignedTickets Ticket[]      @relation("TicketAssignee")
  ticketReplies   TicketReply[] @relation("TicketReplyAuthor")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limit")
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}

enum ReplySenderType {
  AGENT
  CUSTOMER
}

// No email-provider fields like a Message-ID: threading strategy is still
// an open question in project-scope.md, and there's no real provider
// integration yet — see POST /api/tickets.
model Ticket {
  id             Int             @id @default(autoincrement())
  status         TicketStatus    @default(OPEN)
  // Optional, no default: nothing populates this yet (AI classification is
  // a later implementation-plan phase) — it's unset, not defaulted to a
  // guessed category, until that's built.
  category       TicketCategory?
  subject        String
  body           String
  requesterEmail String
  // Nullable: the email ingestion webhook (POST /api/tickets) may or may not
  // resolve a display name for the sender, and tickets created before this
  // field existed have none. Used to address the customer by first name in
  // AI-drafted/polished replies (lib/reply-drafting.ts) — falls back to a generic
  // greeting when null rather than guessing a name from the email address.
  requesterName  String?
  // Nullable, no default: unassigned until a human (or, later, routing
  // logic) claims it. onDelete: SetNull rather than Cascade/Restrict — an
  // assignee going away shouldn't delete or block deleting the ticket, and
  // User rows are soft-deleted anyway (never actually removed), but the FK
  // constraint still needs a defined behavior.
  assignedToId   String?
  assignedTo     User?           @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  // True when lib/queue.ts's auto-resolve job judged this ticket fully
  // answerable with no human needed, sent a reply on its own (authored by
  // a dedicated "AI Assistant" User — see queue.ts's getOrCreateAiAssistantUser,
  // since TicketReply.authorId still requires a real User), and set status
  // to RESOLVED itself. Distinct from an agent manually resolving a
  // ticket — GET /api/tickets excludes resolvedByAi tickets from its
  // default (no explicit status filter) response so they don't clutter the
  // list agents actually work from, but an explicit status filter still
  // returns them; see project-scope.md's "AI autonomy" decision.
  resolvedByAi   Boolean         @default(false)
  createdAt      DateTime
  updatedAt      DateTime
  replies        TicketReply[]

  @@map("ticket")
}

// A reply on a ticket's thread — purely an internal record for now. Actually
// sending it as an outbound email is implementation-plan.md's Phase 3
// "Manual reply" task, blocked on the same email-provider decision as
// ticket ingestion (see project-scope.md's "Email ingestion" open
// question); this model doesn't assume which provider that ends up being.
model TicketReply {
  id         Int             @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Always a real User today: the only way to create a reply is the
  // authenticated POST /api/tickets/:id/replies endpoint, so authorId
  // always resolves to the agent who wrote it. There's no customer-facing
  // reply path yet (that's the same blocked email-ingestion question as
  // above) — senderType exists so the thread UI can already distinguish
  // a customer reply from an agent one once that path exists, without a
  // migration at that point.
  authorId   String
  author     User            @relation("TicketReplyAuthor", fields: [authorId], references: [id])
  // Set by the server based on who's authenticated, never taken from the
  // request body — POST /api/tickets/:id/replies hardcodes AGENT since
  // every caller there is a signed-in agent. Defaults to AGENT so the
  // migration adding this column doesn't need to backfill existing rows
  // with a guess.
  senderType ReplySenderType @default(AGENT)
  body       String
  createdAt  DateTime

  @@map("ticket_reply")
}
